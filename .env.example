# ─── Job Radar — Environment Variables ───────────────────────────────────────
#
# Copy this file to .env.local for local development
# Set these as environment variables in your Railway/Render/Fly dashboard
#

# ── Adzuna (optional, for real live job listings) ─────────────────────────────
# Free signup at: https://developer.adzuna.com/
# Without this, the app still works — the other free sources (Remotive, HN, etc.) are used.
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ── App Config ────────────────────────────────────────────────────────────────
# The public URL of your deployed app (used for metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=production

# ── Database (required) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/job_radar

# ── Auth (required) ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Required in production on Fly/Railway (both terminate TLS themselves) —
# trustHost: true in auth.config.ts already covers this, but AUTH_TRUST_HOST=true
# is also honored by Auth.js directly if you prefer setting it via env instead.

# ── Resend (optional, for password-reset emails) ──────────────────────────────
# Free signup at: https://resend.com — without this, reset links are logged to
# the server console instead of emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Job Radar <onboarding@resend.dev>
